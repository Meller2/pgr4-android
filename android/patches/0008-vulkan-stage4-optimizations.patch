+spv::Id SpirvShaderTranslator::LoadUint32VectorFromSharedMemory(spv::Id base_address_dwords_int,
+                                                              const int32_t* word_offsets,
+                                                              uint32_t word_count) {
+  assert_true(word_count >= 1 && word_count <= 4);
+  auto make_word_address = [&](int32_t word_offset) -> spv::Id {
+    if (!word_offset) {
+      return base_address_dwords_int;
+    }
+    return builder_->createBinOp(spv::OpIAdd, type_int_, base_address_dwords_int,
+                                 builder_->makeIntConstant(int(word_offset)));
+  };
+
+  if (word_count == 1) {
+    return LoadUint32FromSharedMemory(make_word_address(word_offsets[0]));
+  }
+
+  spv::Id vec_type = type_uint_vectors_[word_count - 1];
+  uint32_t binding_count_log2 = GetSharedMemoryStorageBufferCountLog2();
+  if (!vs_batch_vfetch_ || !binding_count_log2) {
+    spv::Id loaded_words[4];
+    for (uint32_t i = 0; i < word_count; ++i) {
+      loaded_words[i] = LoadUint32FromSharedMemory(make_word_address(word_offsets[i]));
+    }
+    id_vector_temp_.clear();
+    id_vector_temp_.insert(id_vector_temp_.cend(), loaded_words, loaded_words + word_count);
+    return builder_->createCompositeConstruct(vec_type, id_vector_temp_);
+  }
+
+  int32_t min_offset = word_offsets[0];
+  int32_t max_offset = word_offsets[0];
+  for (uint32_t i = 1; i < word_count; ++i) {
+    min_offset = std::min(min_offset, word_offsets[i]);
+    max_offset = std::max(max_offset, word_offsets[i]);
+  }
+  uint32_t span = uint32_t(max_offset - min_offset);
+
+  spv::Id first_address = make_word_address(min_offset);
+  uint32_t binding_address_bits = (29 - 2) - binding_count_log2;
+  uint32_t binding_mask = (uint32_t(1) << binding_address_bits) - 1;
+  spv::Id binding_index = builder_->createBinOp(
+      spv::OpShiftRightLogical, type_uint_,
+      builder_->createUnaryOp(spv::OpBitcast, type_uint_, first_address),
+      builder_->makeUintConstant(binding_address_bits));
+  spv::Id binding_address = builder_->createBinOp(
+      spv::OpBitwiseAnd, type_int_, first_address, builder_->makeIntConstant(int(binding_mask)));
+
+  // Fast path: all words of the element reside in the same shared-memory SSBO binding.
+  spv::Id no_bank_cross = builder_->createBinOp(
+      spv::OpULessThanEqual, type_bool_,
+      builder_->createUnaryOp(spv::OpBitcast, type_uint_, binding_address),
+      builder_->makeUintConstant(binding_mask - span));
+  SpirvBuilder::IfBuilder if_same_bank(no_bank_cross, spv::SelectionControlDontFlattenMask,
+                                       *builder_);
+  spv::Id fast_vec;
+  {
+    spv::StorageClass storage_class = features_.spirv_version >= spv::Spv_1_3
+                                          ? spv::StorageClassStorageBuffer
+                                          : spv::StorageClassUniform;
+    spv::Id word_binding_addresses[4];
+    for (uint32_t i = 0; i < word_count; ++i) {
+      int32_t delta = word_offsets[i] - min_offset;
+      word_binding_addresses[i] =
+          delta ? builder_->createBinOp(spv::OpIAdd, type_int_, binding_address,
+                                        builder_->makeIntConstant(int(delta)))
+                : binding_address;
+    }
+
+    id_vector_temp_.clear();
+    id_vector_temp_.insert(id_vector_temp_.cend(), word_count, const_uint_0_);
+    spv::Id vec_zero = builder_->makeCompositeConstant(vec_type, id_vector_temp_);
+
+    auto fast_phi_op =
+        std::make_unique<spv::Instruction>(builder_->getUniqueId(), vec_type, spv::OpPhi);
+    fast_phi_op->addIdOperand(vec_zero);
+    fast_phi_op->addIdOperand(builder_->getBuildPoint()->getId());
+
+    SpirvBuilder::SwitchBuilder binding_switch(binding_index, spv::SelectionControlDontFlattenMask,
+                                               *builder_);
+    uint32_t binding_count = uint32_t(1) << binding_count_log2;
+
+    for (uint32_t b = 0; b < binding_count; ++b) {
+      binding_switch.makeBeginCase(b);
+      spv::Id binding_const = builder_->makeIntConstant(int(b));
+      spv::Id case_words[4];
+      for (uint32_t i = 0; i < word_count; ++i) {
+        id_vector_temp_.clear();
+        id_vector_temp_.push_back(binding_const);
+        id_vector_temp_.push_back(const_int_0_);
+        id_vector_temp_.push_back(word_binding_addresses[i]);
+        case_words[i] = builder_->createLoad(
+            builder_->createAccessChain(storage_class, buffers_shared_memory_, id_vector_temp_),
+            spv::NoPrecision);
+      }
+      id_vector_temp_.clear();
+      id_vector_temp_.insert(id_vector_temp_.cend(), case_words, case_words + word_count);
+      spv::Id case_vec = builder_->createCompositeConstruct(vec_type, id_vector_temp_);
+      fast_phi_op->addIdOperand(case_vec);
+      fast_phi_op->addIdOperand(builder_->getBuildPoint()->getId());
+    }
+
+    binding_switch.makeEndSwitch();
+    fast_vec = fast_phi_op->getResultId();
+    builder_->getBuildPoint()->addInstruction(std::move(fast_phi_op));
+  }
+  if_same_bank.makeBeginElse();
+  spv::Id slow_vec;
+  {
+    spv::Id slow_words[4];
+    for (uint32_t i = 0; i < word_count; ++i) {
+      slow_words[i] = LoadUint32FromSharedMemory(make_word_address(word_offsets[i]));
+    }
+    id_vector_temp_.clear();
+    id_vector_temp_.insert(id_vector_temp_.cend(), slow_words, slow_words + word_count);
+    slow_vec = builder_->createCompositeConstruct(vec_type, id_vector_temp_);
+  }
+  if_same_bank.makeEndIf();
+  return if_same_bank.createMergePhi(fast_vec, slow_vec);
+}
