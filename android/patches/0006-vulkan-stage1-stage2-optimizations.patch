+void* VulkanTextureCache::FindDirectAtalhoTexture(const Atalho& atalho) {
+  if (atalho.dest_base != atalho.extent_start || !atalho.extent_length) {
+    return nullptr;
+  }
+  const uint32_t ext_start = atalho.extent_start;
+  const uint32_t ext_end = atalho.extent_start + atalho.extent_length;
+  auto matches_atalho = [&](const VulkanTexture* tex) -> bool {
+    if (!tex) {
+      return false;
+    }
+    const TextureKey key = tex->key();
+    if (!key.is_valid || key.scaled_resolve || !key.tiled || key.signed_separate ||
+        key.dimension != xenos::DataDimension::k2DOrStacked || key.GetDepthOrArraySize() != 1 ||
+        key.mip_max_level != 0 || (key.base_page << 12) != atalho.dest_base ||
+        key.GetWidth() != atalho.width || key.GetHeight() != atalho.height ||
+        key.pitch != atalho.pitch_div_32 ||
+        GetBaseFormat(key.format) != GetBaseFormat(atalho.format)) {
+      return false;
+    }
+    const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+    if (host_format_pair.format_unsigned.format != atalho.vk_format ||
+        (!IsSignedVersionSeparateForFormat(key) &&
+         host_format_pair.format_unsigned.load_shader == kLoadShaderIndexUnknown)) {
+      return false;
+    }
+    return tex->GetGuestBaseSize() <= atalho.extent_length;
+  };
+  auto cached = direct_atalho_cache_.find(atalho.dest_base);
+  if (cached != direct_atalho_cache_.end()) {
+    return (cached->second && matches_atalho(cached->second)) ? cached->second : nullptr;
+  }
+  VulkanTexture* candidate = nullptr;
+  size_t overlap_count = 0;
+  for (const auto& entry : textures()) {
+    VulkanTexture* tex = static_cast<VulkanTexture*>(entry.second.get());
+    if (!tex) {
+      continue;
+    }
+    const TextureKey key = tex->key();
+    bool overlaps = false;
+    if (key.base_page != 0) {
+      const uint32_t base_start = key.base_page << 12;
+      const uint32_t base_end = base_start + std::max(tex->GetGuestBaseSize(), UINT32_C(1));
+      if (base_start < ext_end && ext_start < base_end) {
+        overlaps = true;
+      }
+    }
+    if (!overlaps && key.mip_max_level > 0 && key.mip_page != 0) {
+      const uint32_t mip_start = key.mip_page << 12;
+      const uint32_t mip_end = mip_start + std::max(tex->GetGuestMipsSize(), UINT32_C(1));
+      if (mip_start < ext_end && ext_start < mip_end) {
+        overlaps = true;
+      }
+    }
+    if (overlaps) {
+      candidate = tex;
+      if (++overlap_count > 1) {
+        break;
+      }
+    }
+  }
+  if (overlap_count == 0) {
+    return nullptr;
+  }
+  if (overlap_count == 1 && matches_atalho(candidate)) {
+    direct_atalho_cache_[atalho.dest_base] = candidate;
+    return candidate;
+  }
+  direct_atalho_cache_[atalho.dest_base] = nullptr;
+  return nullptr;
+}
+
+void VulkanTextureCache::PrepareDirectAtalhoDestination(void* texture, VkImage& image_out) {
+  VulkanTexture* vulkan_tex = static_cast<VulkanTexture*>(texture);
+  vulkan_tex->MarkAsUsed();
+  image_out = vulkan_tex->image();
+  VulkanTexture::Usage old_usage = vulkan_tex->SetUsage(VulkanTexture::Usage::kTransferDestination);
+  if (old_usage == VulkanTexture::Usage::kTransferDestination) {
+    command_processor_.PushImageMemoryBarrier(
+        image_out, ui::vulkan::util::InitializeSubresourceRange(), VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+        VK_ACCESS_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+  } else {
+    VkPipelineStageFlags src_stage, dst_stage;
+    VkAccessFlags src_access, dst_access;
+    VkImageLayout old_layout, new_layout;
+    GetTextureUsageMasks(old_usage, src_stage, src_access, old_layout);
+    GetTextureUsageMasks(VulkanTexture::Usage::kTransferDestination, dst_stage, dst_access,
+                         new_layout);
+    command_processor_.PushImageMemoryBarrier(image_out,
+                                              ui::vulkan::util::InitializeSubresourceRange(),
+                                              src_stage, dst_stage, src_access, dst_access,
+                                              old_layout, new_layout);
+  }
+}
+
+void VulkanTextureCache::TransitionTextureToSampled(void* texture) {
+  VulkanTexture* vulkan_tex = static_cast<VulkanTexture*>(texture);
+  VulkanTexture::Usage old_usage = vulkan_tex->SetUsage(VulkanTexture::Usage::kGuestShaderSampled);
+  if (old_usage != VulkanTexture::Usage::kGuestShaderSampled) {
+    VkPipelineStageFlags src_stage, dst_stage;
+    VkAccessFlags src_access, dst_access;
+    VkImageLayout old_layout, new_layout;
+    GetTextureUsageMasks(old_usage, src_stage, src_access, old_layout);
+    GetTextureUsageMasks(VulkanTexture::Usage::kGuestShaderSampled, dst_stage, dst_access,
+                         new_layout);
+    command_processor_.PushImageMemoryBarrier(vulkan_tex->image(),
+                                              ui::vulkan::util::InitializeSubresourceRange(),
+                                              src_stage, dst_stage, src_access, dst_access,
+                                              old_layout, new_layout);
+  }
+}
+
+void VulkanTextureCache::CompleteDirectAtalho(void* texture, const Atalho& atalho) {
+  VulkanTexture* vulkan_tex = static_cast<VulkanTexture*>(texture);
+  const uint64_t frame = command_processor_.GetCurrentFrame();
+  const uint32_t stale_end = atalho.extent_start + atalho.extent_length;
+  for (size_t i = atalhos_.size(); i-- > 0;) {
+    const Atalho& old = atalhos_[i];
+    if ((old.extent_start < stale_end &&
+         atalho.extent_start < old.extent_start + old.extent_length) ||
+        old.frame + 4 < frame) {
+      ReleaseAtalho(i);
+    }
+  }
+  atalho_stale_.erase(std::remove_if(atalho_stale_.begin(), atalho_stale_.end(),
+                                     [&](const AtalhoStale& s) {
+                                       return s.start < stale_end &&
+                                              atalho.extent_start < s.start + s.length;
+                                     }),
+                      atalho_stale_.end());
+  atalho_stale_.push_back({atalho.extent_start, atalho.extent_length, atalho.dest_base});
+  MarkRangeAsResolved(atalho.extent_start, atalho.extent_length);
+  MakeTextureUpToDateAndWatch(*vulkan_tex);
+  g_cp_times.atalho_hits.fetch_add(1, std::memory_order_relaxed);
+}
+
 void VulkanTextureCache::AddAtalho(const Atalho& atalho) {
   const uint64_t frame = command_processor_.GetCurrentFrame();
   const uint32_t end = atalho.extent_start + atalho.extent_length;
