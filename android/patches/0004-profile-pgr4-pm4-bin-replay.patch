+// Compare addresses AND packet contents. This identifies repeated command packets, not equality
+// of the surrounding GPU state, shader outputs, or pixels covered by the two draws.
+using ReplayPacket = std::pair<uintptr_t, uint64_t>;
+thread_local uint32_t pgr4_replay_frame = 0;
+
+void ProfilePgr4BinReplay(uint32_t frame, uint64_t bin, uint32_t opcode, uint32_t packet,
+                          uint32_t count, memory::RingBuffer& reader, const RegisterFile& regs) {
+  static thread_local std::vector<ReplayPacket> draws[2][2];  // Color/depth, then bin A/B.
+  if (opcode == PM4_XE_SWAP) {
+    for (size_t mode = 0; mode < 2; ++mode) {
+      auto& a = draws[mode][0];
+      auto& b = draws[mode][1];
+      if (!a.empty() || !b.empty()) {
+        const size_t calls_a = a.size(), calls_b = b.size();
+        auto sort_unique = [](auto& packets) {
+          std::sort(packets.begin(), packets.end());
+          packets.erase(std::unique(packets.begin(), packets.end()), packets.end());
+        };
+        sort_unique(a);
+        sort_unique(b);
+        size_t common = 0;
+        auto left = a.begin(), right = b.begin();
+        while (left != a.end() && right != b.end()) {
+          if (*left < *right) {
+            ++left;
+          } else if (*right < *left) {
+            ++right;
+          } else {
+            ++common;
+            ++left;
+            ++right;
+          }
+        }
+        REXGPU_INFO("[pgr4-replay] frame {} {}: bin 80000003 {} calls/{} unique, "
+                    "bin 0000000C {} calls/{} unique, {} shared packets",
+                    frame, mode == 0 ? "color-depth" : "depth-only", calls_a, a.size(),
+                    calls_b, b.size(), common);
+        a.clear();
+        b.clear();
+      }
+    }
+    return;
+  }
+  const auto mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (mode != xenos::EdramMode::kColorDepth && mode != xenos::EdramMode::kDepthOnly) {
+    return;
+  }
+  const auto payload = reader.BeginRead(size_t(count) * sizeof(uint32_t));
+  uint64_t hash = XXH3_64bits_withSeed(payload.first, payload.first_length, packet);
+  if (payload.second_length) {
+    hash = XXH3_64bits_withSeed(payload.second, payload.second_length, hash);
+  }
+  draws[mode == xenos::EdramMode::kDepthOnly][bin == 0xC].emplace_back(reader.read_ptr(), hash);
+}
